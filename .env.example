# =============================================================================
# Vehicle Offer Extraction — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in the values (at minimum a Gemini API key):
#     cp .env.example .env
# All variables below are optional except the LLM API key. Defaults shown are
# the same as in app/core/config.py. Names are case-insensitive.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="Vehicle Offer Extraction API"
APP_ENV=local
API_V1_PREFIX=/api/v1
# Root directory for generated output (per-type subfolders are created here).
LOCAL_STORAGE_DIR=./storage/offers
# Timezone used for output timestamps.
APP_TIMEZONE=Asia/Kolkata

# --- LLM (Gemini) ------------------------------------------------------------
LLM_PROVIDER=gemini

# REQUIRED: single Gemini API key.
GEMINI_API_KEY=your-gemini-api-key-here
# OPTIONAL: comma-separated keys for higher throughput. Each concurrent LLM
# call picks a distinct key to spread past a single key's rate limit.
# Falls back to GEMINI_API_KEY when empty.
# GEMINI_API_KEYS=key1,key2,key3,key4,key5

GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=2
GEMINI_MAX_TOKENS=32000

# --- Scraping / parsing ------------------------------------------------------
# Max characters of page body sent to the LLM per URL.
MAX_BODY_CHARS=350000

# --- Parallel processing (default 5 workers each) ----------------------------
# Number of dealer URLs scraped in parallel (each = 1 headless browser).
SCRAPER_MAX_WORKERS=5
# Number of dealers whose offers are extracted (LLM) in parallel.
DEALER_EXTRACT_WORKERS=5

# --- Input workbook ----------------------------------------------------------
# Default Excel used when the request omits an explicit path.
DEFAULT_EXCEL_PATH=offers/dealer.xlsx

# --- Services Configuration ------------------------------------------------------
sales_specials = true
service_specials = false
schedule_service = false
new_inventory = false
certified_inventory = false
used_inventory = false
offer_to_purchase = false
